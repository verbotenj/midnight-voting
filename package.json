{
  "name": "midnight-voting",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fictional passport eligibility simulator and proof-backed voting POC on Midnight Preview",
  "author": "verbotenj <20187617+verbotenj@users.noreply.github.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/verbotenj/midnight-voting.git"
  },
  "scripts": {
    "repo:check": "node scripts/check-repository.js",
    "contract:setup": "node scripts/setup-compact.js",
    "contract:compile": "node scripts/compile-voting.js",
    "contract:verify": "node scripts/compile-voting.js --verify",
    "contract:test": "node --test contract-tests/voting.spec.js",
    "contract:prove": "node scripts/prove-voting.js",
    "preview:deploy": "node scripts/deploy-preview.js --submit",
    "preview:status": "node scripts/deploy-preview.js",
    "preview:audit": "node scripts/inspect-preview.js",
    "preview:ui-check": "node scripts/check-preview-ui.js",
    "preview:ui-ballot": "node scripts/run-preview-ui.js --submit",
    "start:preview": "MIDNIGHT_LIVE_ACTIONS=1 node server.js",
    "preview:ballot": "node scripts/run-preview-ballot.js --submit",
    "wallets:init": "node scripts/dev-wallets.js init",
    "wallets:show": "node scripts/dev-wallets.js show",
    "wallets:preview": "node scripts/switch-preview.js",
    "wallets:status": "node scripts/register-dust.js",
    "wallets:register-dust": "node scripts/register-dust.js --submit",
    "wallets:receipts": "node scripts/verify-dust-receipts.js",
    "prover:start": "docker compose -p private-ballot-dev -f compose.prover.yml up -d",
    "start": "node server.js",
    "start:public": "node public-server.js",
    "dev:cloudflare": "node scripts/cloudflare.js dev --ip 127.0.0.1 --port 4176",
    "check:cloudflare": "node --check cloudflare/worker.js && node --check public/app.js && node --test tests/domain.test.js test/cloudflare-store.test.js test/public-server.test.js test/payload-inspector.test.js test/privacy-lens.test.js",
    "build:cloudflare": "node scripts/cloudflare.js deploy --dry-run --outdir .local/cloudflare-build",
    "deploy:cloudflare": "node scripts/cloudflare.js deploy",
    "test:cloudflare": "playwright test --config playwright.cloudflare.config.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:public": "playwright test --config playwright.public.config.js",
    "test:e2e:headed": "playwright test --headed --project=desktop",
    "check": "node --check server.js && node --check public/app.js && node --check public/demo-player.js && node --check public/payload-inspector.js && node --check public/preview-ballot.js && node --check public/wallet-lab.js && node --test"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.2",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.2",
    "@midnightntwrk/wallet-sdk": "1.2.0",
    "@playwright/test": "1.63.0",
    "@scure/base": "2.4.0",
    "effect": "3.22.2",
    "rxjs": "7.8.2",
    "wrangler": "4.131.2",
    "ws": "8.21.3"
  }
}
